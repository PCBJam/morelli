# Deploy-time secrets for ./deploy.sh. Copy to .env.deploy (gitignored) and
# fill in. Uploaded atomically with every deploy via `wrangler deploy
# --secrets-file` — the Worker's secret set is exactly this file.

# S3 keypair for pcbjam-ci-screenshots (prod CF account, read+write+list).
SCREENSHOTS_S3_ENDPOINT=
SCREENSHOTS_S3_ACCESS_KEY_ID=
SCREENSHOTS_S3_SECRET_ACCESS_KEY=

# Staging GitHub OAuth app. Callback URL:
#   https://pcbjam-morelli-staging.pcbjam-staging.workers.dev/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any long random string (openssl rand -hex 32). Rotating it signs everyone out.
SESSION_SECRET=

# Comma-separated GitHub-verified emails allowed to sign in. Empty ⇒ the
# Worker fail-closes with 503 for everything.
ALLOWED_EMAILS=

# Optional: Discord webhook for promote notifications.
DISCORD_WEBHOOK_URL=
